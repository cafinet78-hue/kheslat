{
  "name": "shorts",
  "private": true,
  "version": "0.0.0",
  "description": "Remotion project for the cartoon-3d-short skill (.claude/skills/cartoon-3d-short)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/bridge-stills.mjs",
    "render": "remotion render src/index.ts BridgeShort out/bridge/video.mp4 --codec h264 --crf 16"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@remotion/three": "4.0.543",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
